<?xml version="1.0" encoding="UTF-8"?>
<!--
    This file intentionally delegates almost everything to WebAuditCore's
    shared logback include so all services emit identical structured JSON
    logs with OpenTelemetry trace_id/span_id MDC keys (Wave 2.3 of the
    architecture review). Override the root level here if a particular
    service needs a different verbosity.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.neo4j" level="WARN"/>
    <logger name="com.google.cloud" level="WARN"/>
</configuration>
