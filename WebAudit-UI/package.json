{
  "name": "webaudit-ui",
  "description": "WebAudit web dashboard",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4200",
    "start": "bash scripts/generate-env-local.sh && bash scripts/generate-config-local.sh && vite --host 0.0.0.0 --port 4200",
    "build": "bash scripts/generate-env-local.sh && bash scripts/generate-config-local.sh && vite build",
    "build:direct": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4200",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "load-env": "node scripts/load-env.js"
  },
  "private": true,
  "dependencies": {
    "@auth0/auth0-react": "^2.2.4",
    "lucide-react": "^0.378.0",
    "pusher-js": "^7.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^15.0.7",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "dotenv": "^16.3.1",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.3.3",
    "vite": "^5.2.11",
    "vitest": "^1.6.0"
  }
}
